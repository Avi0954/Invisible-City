# Root Environment Configuration Example
# Copy this file to .env or use the respective backend/frontend .env files

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Settings
PROJECT_NAME="Invisible City"
API_V1_STR=/api/v1
BACKEND_PORT=8000

# Database Settings (Neon PostgreSQL / PostGIS / pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invisible_city
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173

# AI Layer Settings
AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CONFIDENCE_THRESHOLD=0.70
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=v1
OPENAI_API_KEY=

# Intelligence Engine Settings
INTELLIGENCE_CANDIDATE_RADIUS_METERS=1000
MAX_SIMILARITY_CANDIDATES=50
MAX_RELATED_REPORTS=20
DUPLICATE_THRESHOLD=0.85
RELATED_THRESHOLD=0.60
SIMILARITY_WEIGHT_SEMANTIC=0.40
SIMILARITY_WEIGHT_GEO=0.30
SIMILARITY_WEIGHT_CATEGORY=0.15
SIMILARITY_WEIGHT_TIME=0.15
HOTSPOT_LOOKBACK_DAYS=30
HOTSPOT_EPSILON_METERS=300
HOTSPOT_MIN_REPORTS=3
INTELLIGENCE_ALGORITHM_VERSION=v1
HOTSPOT_ALGORITHM_VERSION=v1

