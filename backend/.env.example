ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="Invisible City"
API_V1_STR=/api/v1
BACKEND_PORT=8000

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invisible_city
# Neon PostgreSQL Connection URL (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require


CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# AI Layer Settings
AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CONFIDENCE_THRESHOLD=0.70
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=v1
OPENAI_API_KEY=

# Map & Spatial Intelligence Settings
MAP_MAX_REPORTS=500
MAX_NEARBY_RADIUS_METERS=50000.0
DEFAULT_MAP_CENTER_LAT=12.9716
DEFAULT_MAP_CENTER_LNG=77.5946


