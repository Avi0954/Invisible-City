# Backend Environment Configuration Example
# Copy this file to backend/.env and supply real secrets for local development

# ==========================================
# APPLICATION
# ==========================================
PROJECT_NAME="Invisible City"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# ==========================================
# DATABASE (PostgreSQL / Neon / PostGIS / pgvector)
# ==========================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invisible_city

# Neon / Remote PostgreSQL Connection URL (sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET_KEY=GENERATE_A_STRONG_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET_KEY=GENERATE_A_STRONG_RANDOM_REFRESH_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# STORAGE ABSTRACTION
# ==========================================
STORAGE_PROVIDER=local
STORAGE_DIR=uploads
MAX_FILE_SIZE_MB=10

# ==========================================
# AI LAYER & EMBEDDINGS
# ==========================================
AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CONFIDENCE_THRESHOLD=0.70
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=v1
OPENAI_API_KEY=

# ==========================================
# MAP & SPATIAL INTELLIGENCE
# ==========================================
MAP_MAX_REPORTS=500
MAX_NEARBY_RADIUS_METERS=50000.0
DEFAULT_MAP_CENTER_LAT=12.9716
DEFAULT_MAP_CENTER_LNG=77.5946

# ==========================================
# CORE INTELLIGENCE ENGINE & DBSCAN
# ==========================================
INTELLIGENCE_CANDIDATE_RADIUS_METERS=1000.0
MAX_SIMILARITY_CANDIDATES=50
MAX_RELATED_REPORTS=20
DUPLICATE_THRESHOLD=0.85
RELATED_THRESHOLD=0.60
SIMILARITY_WEIGHT_SEMANTIC=0.40
SIMILARITY_WEIGHT_GEO=0.30
SIMILARITY_WEIGHT_CATEGORY=0.15
SIMILARITY_WEIGHT_TIME=0.15
HOTSPOT_LOOKBACK_DAYS=30
HOTSPOT_EPSILON_METERS=300.0
HOTSPOT_MIN_REPORTS=3
INTELLIGENCE_ALGORITHM_VERSION=v1
HOTSPOT_ALGORITHM_VERSION=v1

# ==========================================
# CORS ORIGINS
# ==========================================
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
