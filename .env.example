# Root Environment Configuration Example
# Copy this file to .env or use the respective backend/frontend .env files

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Settings
PROJECT_NAME="Invisible City"
API_V1_STR=/api/v1
BACKEND_PORT=8000

# Database Settings (PostgreSQL + PostGIS + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invisible_city
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invisible_city

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=5173
